cabal-version: 3.4
name: trilby-cli
version: 26.10.1
synopsis: Trilby command line tools
homepage: https://github.com/ners/trilby
license: Apache-2.0
license-file: LICENCE.md
author: ners
maintainer: ners@gmx.ch
category: System
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

common common
  default-language: GHC2021
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-missed-specialisations
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-name-shadowing
    -Wno-orphans
    -Wno-partial-fields
    -Wno-unsafe

  default-extensions:
    ApplicativeDo
    BlockArguments
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    ExplicitNamespaces
    LambdaCase
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeFamilies
    ViewPatterns

library
  import: common
  hs-source-dirs: src
  build-depends:
    Glob,
    aeson,
    aeson-pretty,
    ansi-terminal,
    base,
    bytestring,
    containers,
    data-default,
    data-fix,
    effectful >=2.4,
    extra,
    filepath,
    generic-lens,
    hnix,
    lens,
    lens-family-th,
    log-base,
    log-effectful,
    optparse-applicative,
    path,
    path-io-effectful,
    scientific,
    terminal-widgets,
    text,
    text-rope-zipper,
    time,
    transformers,
    typed-process,
    typed-process-effectful,
    unix,
    unordered-containers,
    xml,

  autogen-modules:
    Paths_trilby_cli

  other-modules:
    Paths_trilby_cli

  exposed-modules:
    Effectful.Path
    Trilby.App
    Trilby.BootloaderEntry
    Trilby.Clean
    Trilby.Clean.Options
    Trilby.Command
    Trilby.Config
    Trilby.Config.Add
    Trilby.Config.Apply
    Trilby.Config.Cache
    Trilby.Config.Check
    Trilby.Config.Diff
    Trilby.Config.Edit
    Trilby.Config.Editor
    Trilby.Config.Effects
    Trilby.Config.Eval
    Trilby.Config.File
    Trilby.Config.Hosts
    Trilby.Config.Json
    Trilby.Config.List
    Trilby.Config.Options
    Trilby.Config.Origin
    Trilby.Config.Profile
    Trilby.Config.Progress
    Trilby.Config.Remove
    Trilby.Config.Rows
    Trilby.Config.Search
    Trilby.Config.Selector
    Trilby.Config.Size
    Trilby.Config.Table
    Trilby.Config.Target
    Trilby.Config.Users
    Trilby.Config.Why
    Trilby.Configuration
    Trilby.Disko
    Trilby.Disko.Disk
    Trilby.Disko.Filesystem
    Trilby.Disko.Partition
    Trilby.FlakeRef
    Trilby.HNix
    Trilby.Host
    Trilby.Infect
    Trilby.Infect.Options
    Trilby.Install
    Trilby.Install.Config.Edition
    Trilby.Install.Config.Host
    Trilby.Install.Config.Keyboard
    Trilby.Install.Config.Release
    Trilby.Install.Config.User
    Trilby.Install.Disko
    Trilby.Install.Flake
    Trilby.Install.Options
    Trilby.Log
    Trilby.Options
    Trilby.Prelude
    Trilby.Process
    Trilby.Setup
    Trilby.System
    Trilby.Update
    Trilby.Update.Options
    Trilby.Util
    Trilby.Version
    Trilby.Widgets

executable trilby
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    effectful >=2.4,
    monad-time-effectful,
    optparse-applicative,
    path-io-effectful,
    trilby-cli,
    typed-process-effectful,

test-suite spec
  import: common
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    QuickCheck,
    aeson,
    base,
    hspec,
    text,
    trilby-cli,

  other-modules:
    Trilby.Config.CacheSpec
    Trilby.Config.EditSpec
    Trilby.Disko.FilesystemSpec
    Trilby.FlakeRefSpec
    Trilby.HostSpec
    Trilby.Install.Config.EditionSpec
    Trilby.Install.Config.ReleaseSpec
    Trilby.SystemSpec
